@implements IDisposable

@inject UiAuthSession Session
@inject UiAuthService Auth
@inject NavigationManager Nav

<nav class="app-navigation">

    @if (!Session.IsAuthenticated)
    {
        <div class="navlabel">PUBLIC</div>

        <NavLink class="nav-link"
                 href="/"
                 Match="NavLinkMatch.All">
            <span class="nav-icon">⌂</span>
            Overview
        </NavLink>

        <NavLink class="nav-link" href="/bff/login" data-enhance-nav="false">
            <span class="nav-icon">⇥</span>
            Sign in
        </NavLink>

        <NavLink class="nav-link" href="/register">
            <span class="nav-icon">＋</span>
            Register tenant
        </NavLink>
    }
    else
    {
        <div class="navlabel">WORKSPACE</div>

        <NavLink class="nav-link" href="/dashboard">
            <span class="nav-icon">▦</span>
            Dashboard
        </NavLink>

        <div class="navlabel">DATA MANAGEMENT</div>

        <NavLink class="nav-link" href="/accounts">
            <span class="nav-icon">♙</span>
            Customer Accounts
        </NavLink>

        <NavLink class="nav-link" href="/imports">
            <span class="nav-icon">⇧</span>
            Data Imports
        </NavLink>

        <div class="navlabel">SYSTEM</div>

        <NavLink class="nav-link" href="/system-status">
            <span class="nav-icon">◉</span>
            System Status
        </NavLink>

        <div class="navlabel">ACCOUNT</div>

        <div class="nav-user-info">
            <strong>@Session.Email</strong>
            <span>@Session.Role</span>
        </div>

        @if (Session.Role == "Admin")
        {
            <NavLink class="nav-link" href="/tenant-settings">
                <span class="nav-icon">⚙</span>
                Tenant Settings
            </NavLink>
        }

        <form method="post" action="/bff/logout">
            <AntiforgeryToken />

            <button type="submit" class="nav-logout">
                Sign out
            </button>
        </form>
    }

</nav>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
