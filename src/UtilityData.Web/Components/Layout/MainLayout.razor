@inherits LayoutComponentBase
@implements IDisposable

@inject UiAuthSession Session

<div class="shell">
    <aside>
        <div class="brand">
            Utility Data <span>Intelligence</span>
        </div>

        <NavMenu />

        <small>LOCAL ENVIRONMENT · .NET 8</small>
    </aside>

    <main>
        <header>
            <div class="header-brand">
                Utility Data Intelligence
            </div>

            @if (Session.IsAuthenticated)
            {
                <div class="tenant-header">
                    <div class="tenant-avatar">
                        @TenantInitial
                    </div>

                    <div class="tenant-details">
                        <strong>@(Session.TenantName ?? "Loading tenant...")</strong>
                        <span>
                            @(Session.Email ?? "Signed in")
                            ·
                            @(Session.Role ?? "User")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Session.TenantCode))
                    {
                        <span class="tenant-code">
                            @Session.TenantCode
                        </span>
                    }
                </div>
            }
            else
            {
                <span class="environment-label">PUBLIC ACCESS</span>
            }
        </header>

        <section>
            @Body
        </section>
    </main>
</div>

@code {
    private string TenantInitial =>
        string.IsNullOrWhiteSpace(Session.TenantName)
            ? "?"
            : Session.TenantName[..1].ToUpperInvariant();

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}