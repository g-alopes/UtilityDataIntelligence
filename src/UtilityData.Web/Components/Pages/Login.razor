@page "/login"

<PageTitle>Sign in | Utility Data Intelligence</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="eyebrow">UTILITY DATA INTELLIGENCE</div>

        <h1>Welcome back</h1>
        <p class="muted">
            Sign in to access your implementation workspace.
        </p>

        <form method="post" action="/bff/login">
            <AntiforgeryToken />

            <div class="form-group">
                <label for="email">Email address</label>
                <input id="email"
                       name="email"
                       type="email"
                       class="form-control"
                       placeholder="admin@company.com"
                       autocomplete="username"
                       required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn-primary">
                Sign in
            </button>
        </form>

        <p class="auth-footer">
            Don't have a workspace?
            <a href="/register">Create a tenant</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "missing" => "Enter your email address and password.",
        "invalid" => "The email address or password is incorrect.",
        "tenant" => "Your tenant could not be loaded or is inactive.",
        _ => null
    };
}
