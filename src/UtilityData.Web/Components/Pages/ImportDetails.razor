@page "/imports/{BatchId:guid}"

@inject UiAuthSession Session
@inject ImportsApiService Imports

<h1>Import Details</h1>

@if (!Session.IsAuthenticated)
{
    <p><a href="/bff/login">Sign in</a> to view this batch.</p>
}
else if (loading)
{
    <p>Loading...</p>
}
else if (batch is not null)
{
    <p><b>File:</b> @batch.FileName</p>
    <p><b>Status:</b> @batch.Status</p>

    <p>
        Total @batch.TotalRecords |
        Valid @batch.ValidRecords |
        Invalid @batch.InvalidRecords |
        Approved @batch.ApprovedRecordCount
    </p>
    @if (Session.Role is "Admin" or "Manager"
        && batch.Status == Domain.Entities.ImportBatchStatus.Completed)
    {
        @if (batch.ValidRecords > 0)
        {
            <button class="btn btn-success"
                    @onclick="Approve"
                    disabled="@busy">
                @(busy ? "Approving..." : "Approve and commit valid records")
            </button>
        }
    }
    @if (message is not null)
    {
        <div class="alert-message @(messageType == "success" ? "alert-success" : "alert-error")">
            @message
        </div>
    }

    <h3 class="mt-4">Validation records</h3>

    @if (records is not null)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Row</th>
                    <th>Result</th>
                    <th>Errors</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in records.Records)
                {
                    <tr>
                        <td>@r.RowNumber</td>
                        <td>@(r.IsValid ? "Valid" : "Invalid")</td>
                        <td>@r.Errors</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public Guid BatchId { get; set; }

    ImportBatchDetailDto? batch;
    ImportRecordsResponse? records;
    bool loading = true, busy;
    string? message, messageType;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated)
        {
            loading = false;
            return;
        }
        try
        {
            batch = await Imports.GetBatchAsync(BatchId);
            records = await Imports.GetRecordsAsync(BatchId);

            if (Session.Role is "Admin" or "Manager"
                  && batch?.Status == Domain.Entities.ImportBatchStatus.Completed 
                    && batch?.ValidRecords == 0)
            {
                message = "Import cannot be approved: This import has no valid records to commit.";
                messageType = "error";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageType = "error";
        }
        finally
        {
            loading = false;
        }
    }

    async Task Approve()
    {
        busy = true;
        message = null;
        messageType = null;

        try
        {
            await Imports.ApproveAsync(BatchId);

            message = "Import approved and records committed successfully.";
            messageType = "success";

            batch = await Imports.GetBatchAsync(BatchId);
            records = await Imports.GetRecordsAsync(BatchId);
        }
        catch (ApiException ex)
        {
            message = ex.Message;
            messageType = "error";
        }
        catch (Exception)
        {
            message = "An unexpected error occurred while approving the import.";
            messageType = "error";
        }
        finally
        {
            busy = false;
        }
    }
}
